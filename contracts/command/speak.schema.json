{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guardian:command:speak",
  "title": "Server -> room agent: say the text (no listening)",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "text"],
  "properties": {
    "type": {"const": "speak"},
    "text": {"type": "string", "minLength": 1}
  }
}
