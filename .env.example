# Guardian settings. Copy this file to .env and fill in the two secrets.
# .env is private: it is never committed or uploaded.

# Secrets: paste these right after the = sign (no spaces, no quotes)
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=

# Not secret
# Family test group chat ID (a negative number for groups)
TELEGRAM_CHAT_ID=
# Small, fast chat model for check-in decisions (measured in Stage 0)
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
SERVER_URL=http://localhost:8000
ROOM_NAME=living_room
CAMERA_INDEX=0
DEMO_MODE=false
